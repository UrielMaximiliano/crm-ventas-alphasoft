# =========================================================
# CRM Ventas Alphasoft - configuracion local
# Copiar a .env y editar segun necesidad
# =========================================================

# --- Base de datos (Postgres + pgvector dentro del compose) ---
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_local_dev
POSTGRES_DB=crm
POSTGRES_PORT=5432

# URLs que usa la app. El host "postgres" es el nombre del servicio en docker-compose.
DATABASE_URL=postgresql+asyncpg://crm:crm_local_dev@postgres:5432/crm
SYNC_DATABASE_URL=postgresql+psycopg2://crm:crm_local_dev@postgres:5432/crm

# --- LLM (Groq) ---
# Conseguir API key gratis en: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Modo mock (default ON) para arrancar sin gastar tokens ni scrapear nada real ---
MOCK_LLM=1
MOCK_SCRAPER=1

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Datos de contacto de Alphasoft (se inyectan en los mensajes generados) ---
ALPHASOFT_EMAIL=alphasoftwebs@gmail.com
ALPHASOFT_INSTAGRAM=@alphasoft__
ALPHASOFT_WEBSITE=https://www.alphasoft.cloud/
# Numero de WhatsApp en formato internacional sin "+" (ej: 5493511234567 para Cordoba AR)
ALPHASOFT_WHATSAPP=

# --- Scraping (se usa cuando MOCK_SCRAPER=0 en Fase 8) ---
SCRAPER_MIN_DELAY_SEC=2
SCRAPER_MAX_DELAY_SEC=5
SCRAPER_DAILY_LIMIT=100

# --- Control de jobs automaticos ---
# 0 = control manual (default): el equipo dispara discover/enrich/generate desde la UI.
# 1 = scheduler activo: corre cron diario 09:00 AR + intervalos definidos.
AUTOSTART_JOBS=0
